<Window x:Class="FirstHawk.ThemesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Theme gallery — FirstHawk" Height="570" Width="760" MinHeight="500" MinWidth="650" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppForeground}" FontFamily="Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="FIRSTHAWK / APPEARANCE" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Theme gallery" FontSize="29" FontWeight="SemiBold" Margin="0,6,0,3"/>
            <TextBlock Text="Preview a style and apply it to the FirstHawk workspace." Foreground="{DynamicResource MutedForeground}" FontSize="12"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ThemeList">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,12,12">
                            <StackPanel>
                                <Border Height="100" CornerRadius="10" Background="{Binding Background}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                                    <Grid Margin="12">
                                        <Border Background="{Binding Surface}" CornerRadius="7" Padding="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="150">
                                            <StackPanel>
                                                <TextBlock Text="FirstHawk" Foreground="{Binding Foreground}" FontSize="11" FontWeight="Bold"/>
                                                <Border Background="{Binding Accent}" Height="5" Width="70" HorizontalAlignment="Left" CornerRadius="3" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Ellipse Width="32" Height="32" Fill="{Binding Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,3"/>
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedForeground}" FontSize="10" TextWrapping="Wrap" MinHeight="28"/>
                                <Button Content="Apply theme" Tag="{Binding}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ApplyTheme_Click"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="GalleryStatus" Grid.Row="2" Text="Choose a theme to preview it." Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,14,0,0"/>
    </Grid>
</Window>
