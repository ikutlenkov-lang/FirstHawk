<Window x:Class="FirstHawk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FirstHawk" Height="780" Width="1240" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="#0B1020" Foreground="#F3F6FF"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#151D31"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA8C4"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F3F6FF"/>
            <Setter Property="Background" Value="#222E49"/>
            <Setter Property="BorderBrush" Value="#344363"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#30436A"/><Setter TargetName="bd" Property="BorderBrush" Value="#718FD5"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.78"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="#151D31"/>
            <Setter Property="BorderBrush" Value="#263451"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0E1527" BorderBrush="#202B43" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,8,0,30">
                        <Border Width="38" Height="38" CornerRadius="12" Background="#293D70">
                            <TextBlock Text="✦" FontSize="23" Foreground="#AFC4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FirstHawk" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="WINDOWS STUDIO" FontSize="9" Foreground="#8797B7"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#6F7F9F" FontSize="10" FontWeight="Bold" Margin="8,0,0,10"/>
                    <Button Content="⌂   Overview" HorizontalContentAlignment="Left" Background="#26365B" BorderBrush="#425D99" Margin="0,0,0,6" Click="Overview_Click"/>
                    <Button Content="◈   Themes" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,6" Click="Themes_Click"/>
                    <Button Content="▤   Taskbar" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,6" Click="Taskbar_Click"/>
                    <Button Content="▦   Desktop" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,6" Click="Desktop_Click"/>
                    <Button Content="✧   Effects" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,6" Click="Effects_Click"/>
                    <Button Content="⬡   Mod library" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,6" Click="Library_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#17233B" CornerRadius="14" Padding="13" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="FIRSTHAWK 0.1" Foreground="#AFC4FF" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Your desktop. Your rules." FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Button Content="⚙   Settings" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Click="Settings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,28,34,34">
                <Grid Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock x:Name="PageEyebrow" Text="YOUR WINDOWS, REIMAGINED" Foreground="#91A8E8" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="PageTitle" Text="Good afternoon." FontSize="32" FontWeight="SemiBold" Margin="0,7,0,4"/>
                        <TextBlock x:Name="PageSubtitle" Text="A calmer, more personal desktop starts here." Foreground="#9AA8C4" FontSize="14"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#15233B" BorderBrush="#2B426A" BorderThickness="1" CornerRadius="20" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#54D6A0" Margin="0,0,8,0"/>
                            <TextBlock x:Name="OsLabel" Text="Windows detected" FontSize="11" Foreground="#C9D8F5"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border CornerRadius="22" Padding="26" Margin="0,0,0,20" BorderBrush="#3A4F85" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#263D78" Offset="0"/>
                            <GradientStop Color="#28234F" Offset="0.55"/>
                            <GradientStop Color="#17233D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FEATURED COLLECTION" FontSize="10" FontWeight="Bold" Foreground="#B7C9FF"/>
                            <TextBlock Text="Find your look." FontSize="30" FontWeight="SemiBold" Margin="0,10,0,5"/>
                            <TextBlock Text="Explore curated visual styles for your FirstHawk workspace." Foreground="#D3DDF8" FontSize="13" MaxWidth="430" TextWrapping="Wrap"/>
                            <Button Content="Explore themes  →" HorizontalAlignment="Left" Margin="0,20,0,0" Background="#7898F7" BorderBrush="#A7BAFF" Foreground="#101A35" FontWeight="SemiBold" Click="Themes_Click"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="18,0,0,0">
                            <Border CornerRadius="17" Background="#182441" BorderBrush="#708DD4" BorderThickness="1" Padding="13">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Border CornerRadius="10" Background="#293B67" Margin="0,0,0,9">
                                        <Grid>
                                            <Ellipse Width="100" Height="100" Fill="#627FD1" Opacity="0.35" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-25,-20,0"/>
                                            <Border Width="85" Height="55" Background="#A5B9FF" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                                            <Border Width="105" Height="5" Background="#D7E1FF" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="MIDNIGHT" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="A little less ordinary." Foreground="#AABBE3" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Text="QUICK ACCESS" Foreground="#8192B4" FontSize="10" FontWeight="Bold" Margin="2,0,0,12"/>
                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,22">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="◈" FontSize="22" Foreground="#A9BFFF"/>
                            <TextBlock Text="Themes" FontSize="16" FontWeight="SemiBold" Margin="0,13,0,4"/>
                            <TextBlock Text="Choose a visual identity" Foreground="#9AA8C4" FontSize="11"/>
                            <Button Content="Browse themes" HorizontalAlignment="Left" Margin="0,15,0,0" Click="Themes_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="▤" FontSize="22" Foreground="#8CE0C2"/>
                            <TextBlock Text="Taskbar" FontSize="16" FontWeight="SemiBold" Margin="0,13,0,4"/>
                            <TextBlock Text="A cleaner taskbar look" Foreground="#9AA8C4" FontSize="11"/>
                            <Button Content="Coming soon" HorizontalAlignment="Left" Margin="0,15,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="✧" FontSize="22" Foreground="#D4A8FF"/>
                            <TextBlock Text="Effects" FontSize="16" FontWeight="SemiBold" Margin="0,13,0,4"/>
                            <TextBlock Text="Motion and visual polish" Foreground="#9AA8C4" FontSize="11"/>
                            <Button Content="Coming soon" HorizontalAlignment="Left" Margin="0,15,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="SYSTEM SNAPSHOT" Foreground="#8192B4" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="SystemName" Text="Windows" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,2"/>
                            <TextBlock x:Name="SystemVersion" Text="Checking system version…" Foreground="#9AA8C4" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Grid.Column="1" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="SAFE BY DESIGN" Foreground="#8192B4" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Reversible changes" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,2"/>
                            <TextBlock Text="Visual modules will include clear previews and restore options." Foreground="#9AA8C4" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="StatusText" Text="FirstHawk is ready." Foreground="#7183A6" FontSize="11" Margin="2,20,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
